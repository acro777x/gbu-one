# ---------------------------------------------------------------------------
# GBU One - environment template.
#
# Copy to `.env` and fill in. `.env` is git-ignored and must never be
# committed.
#
# IMPORTANT: any variable named EXPO_PUBLIC_* is INLINED INTO THE JAVASCRIPT
# BUNDLE by Expo at build time and therefore ships to every student. Only
# publishable, non-secret values may use that prefix. The build script
# (tools/build_android_apk.py) refuses to produce a release build if an
# EXPO_PUBLIC_* value turns out to be a Supabase secret key.
# ---------------------------------------------------------------------------

# --- App ------------------------------------------------------------------
APP_ENV=development

# --- Supabase: the APP's own client ---------------------------------------
# The anon key MUST be a PUBLISHABLE key (sb_publishable_...). If it is a
# secret key (sb_secret_...) every student who installs the app holds a
# credential that bypasses every row level security policy in the project.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase: the WORKER only (never in the app) -------------------------
# Used by worker/ and by the GitHub Actions cron. It needs the service-role
# key because it writes the tables the app may only read.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=  # Worker only - never in the app

# --- Scraper ---------------------------------------------------------------
TIMETABLE_API_BASE_URL=
TIMETABLE_API_KEY=

# --- Worker OCR ------------------------------------------------------------
# tesseract | vision
OCR_PROVIDER=tesseract
# Only needed when OCR_PROVIDER=vision. Worker only.
VISION_API_KEY=

# --- Worker ----------------------------------------------------------------
# The address published in the app as the takedown / contact address.
WORKER_CONTACT_EMAIL=
# Expo Push API token. Worker only - never in the app.
EXPO_ACCESS_TOKEN=

# --- Build ----------------------------------------------------------------
# 'public' for the student app, 'admin' for the dedicated admin APK.
EXPO_PUBLIC_APP_VARIANT=public
