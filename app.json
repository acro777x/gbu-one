{
  "expo": {
    "name": "GBU One",
    "slug": "gbu-one",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon-1024.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/brand/splash-mark.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6F7FB"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.gbu.one"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/android-adaptive-foreground.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "in.gbu.one"
    },
    "web": {
      "favicon": "./assets/brand/favicon-32.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Poppins-Bold.ttf",
            "./assets/fonts/Inter-Regular.ttf",
            "./assets/fonts/Inter-Medium.ttf",
            "./assets/fonts/Inter-SemiBold.ttf",
            "./assets/fonts/Inter-Bold.ttf"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F7FB",
          "image": "./assets/brand/splash-mark.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/notification-icon.png",
          "defaultChannel": "timetable_changes",
          "color": "#4F46E5",
          "sounds": [
            "./assets/sounds/class_alarm.mp3"
          ]
        }
      ],
      "./plugins/withReleaseSigning"
    ],
    "scheme": "gbuone"
  }
}
